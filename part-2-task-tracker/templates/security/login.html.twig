{% extends 'base.html.twig' %}

{% block title %}Log in — Task tracker{% endblock %}

{% block body %}
    <h1>Log in</h1>

    {% if error %}
        {# messageKey/messageData, not getMessage(): auth failure messages are
           translation-safe and never leak internals. #}
        <p class="error">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
    {% endif %}

    <form method="post" action="{{ path('app_login') }}">
        <p>
            <label for="username">Email</label><br>
            <input type="email" id="username" name="_username" value="{{ lastUsername }}" autocomplete="email" required autofocus>
        </p>
        <p>
            <label for="password">Password</label><br>
            <input type="password" id="password" name="_password" autocomplete="current-password" required>
        </p>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <p><button type="submit">Sign in</button></p>
    </form>
{% endblock %}
